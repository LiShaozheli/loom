{
  "name": "loom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LOOM — 分层记忆：AI文 做证据、题档 做路标、哈希链保证可验、epoch 加密保证可删",
  "license": "MIT",
  "engines": {
    "node": ">=22.19 <23"
  },
  "bin": {
    "loom": "./packages/loom-core/bin/loom.js"
  },
  "files": [
    "packages/loom-core/src",
    "packages/loom-core/bin",
    "tools",
    "README.md"
  ],
  "scripts": {
    "test": "node --test packages/loom-core/test/*.test.js",
    "demo": "node packages/loom-core/bin/loom.js demo",
    "verify": "node packages/loom-core/bin/loom.js verify",
    "recall": "node packages/loom-core/bin/loom.js recall",
    "admission": "node tools/admission-eval.mjs",
    "distill": "node tools/distill.mjs",
    "settle": "node tools/settle-eval.mjs",
    "dedupe": "node tools/dedupe.mjs",
    "retrieval": "node tools/retrieval-eval.mjs",
    "reindex": "node tools/reindex.mjs",
    "vendor:sync": "node tools/vendor-sync.mjs",
    "vendor:check": "node tools/vendor-sync.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/loom-core/{src,bin,test}/**/*.js\" \"packages/loom-dsh/*.js\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"packages/loom-core/{src,bin,test}/**/*.js\" \"packages/loom-dsh/*.js\" \"tools/**/*.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run vendor:check && npm run lint && npm run format:check && npm test && npm run verify",
    "migrate": "node tools/migrate.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
