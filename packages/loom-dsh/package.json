{
  "name": "loom-memory",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "LOOM 记忆：AI文 证据 + 写入闸门 + 预算取回 + 自动注入 + 侧边栏面板",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "vendor",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
